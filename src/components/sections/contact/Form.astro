---
import SectionTag from "../../SectionTag.astro";
import { form } from "../../../data/contact";

const pillBase =
  "font-mono text-xs uppercase px-4 min-h-11 rounded-md border cursor-pointer transition-colors tracking-mono";
const pillOn = "bg-text text-bg border-text";
const pillOff =
  "bg-transparent text-text-muted border-hairline hover:text-text hover:border-text-muted";
---

<div
  x-data={`{
    form: { name: '', email: '', company: '', projectType: '${form.defaultProjectType}', budget: '${form.defaultBudget}', message: '', botcheck: false },
    submitted: false,
    receivedAt: '',
    sending: false,
    error: false,
    focused: null,
    async submit(e) {
      e.preventDefault();
      if (this.sending) return;
      if (!this.form.name || !this.form.email || !this.form.message) return;
      this.sending = true;
      this.error = false;
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: '${form.web3formsKey}',
            subject: 'New inquiry from ' + this.form.name,
            from_name: 'tonyvoorhees.com',
            name: this.form.name,
            email: this.form.email,
            company: this.form.company,
            project_type: this.form.projectType || 'Not specified',
            budget: this.form.budget || 'Not specified',
            message: this.form.message,
            botcheck: this.form.botcheck,
          }),
        });
        const data = await res.json();
        if (data.success) {
          this.receivedAt = new Date().toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
          this.submitted = true;
          this.$nextTick(() => this.$refs.thanks.focus());
        } else { this.error = true; }
      } catch (err) {
        this.error = true;
      } finally {
        this.sending = false;
      }
    }
  }`}
>
  <SectionTag num={form.sectionTag.num} label={form.sectionTag.label} />

  <form x-show="!submitted" x-on:submit="submit($event)" class="mt-8">
    {/* Honeypot — bots tick it, Web3Forms drops the submission */}
    <input
      type="checkbox"
      x-model="form.botcheck"
      tabindex="-1"
      autocomplete="off"
      class="hidden"
      aria-hidden="true"
    />
    <label class="block border-t border-hairline pt-5 pb-1 relative">
      <span
        class="font-mono uppercase text-micro transition-colors tracking-mono-loose"
        x-bind:class="focused === 'name' ? 'text-accent' : 'text-text-muted'"
      >
        Your name <span class="text-accent">*</span>
      </span>
      <input
        required
        type="text"
        autocomplete="name"
        x-model="form.name"
        x-on:focus="focused = 'name'"
        x-on:blur="focused = null"
        class="w-full bg-transparent border-none outline-none font-serif text-xl md:text-2xl text-text py-2 tracking-tight"
      />
    </label>

    {/* Email */}
    <label class="block border-t border-hairline pt-5 pb-1 relative">
      <span
        class="font-mono uppercase text-micro transition-colors tracking-mono-loose"
        x-bind:class="focused === 'email' ? 'text-accent' : 'text-text-muted'"
      >
        Email address <span class="text-accent">*</span>
      </span>
      <input
        required
        type="email"
        autocomplete="email"
        x-model="form.email"
        x-on:focus="focused = 'email'"
        x-on:blur="focused = null"
        class="w-full bg-transparent border-none outline-none font-serif text-xl md:text-2xl text-text py-2 tracking-tight"
      />
    </label>

    {/* Company */}
    <label class="block border-t border-hairline pt-5 pb-1 relative">
      <span
        class="font-mono uppercase text-micro transition-colors tracking-mono-loose"
        x-bind:class="focused === 'company' ? 'text-accent' : 'text-text-muted'"
      >
        Company or studio
      </span>
      <input
        type="text"
        autocomplete="organization"
        x-model="form.company"
        x-on:focus="focused = 'company'"
        x-on:blur="focused = null"
        class="w-full bg-transparent border-none outline-none font-serif text-xl md:text-2xl text-text py-2 tracking-tight"
      />
    </label>

    {/* Project type — pill picker */}
    <div class="block border-t border-hairline pt-5 pb-1" role="group" aria-labelledby="project-label">
      <span id="project-label" class="font-mono uppercase text-micro text-text-muted tracking-mono-loose">
        What's the project?
      </span>
      <div class="flex gap-2 flex-wrap mt-3 mb-3">
        {form.projectTypes.map((t) => (
          <button
            type="button"
            x-on:click={`form.projectType = form.projectType === '${t}' ? '' : '${t}'`}
            x-bind:class={`form.projectType === '${t}' ? '${pillOn}' : '${pillOff}'`}
            x-bind:aria-pressed={`form.projectType === '${t}'`}
            class={pillBase}
          >
            {t}
          </button>
        ))}
      </div>
    </div>

    {/* Budget — pill picker */}
    <div class="block border-t border-hairline pt-5 pb-1" role="group" aria-labelledby="budget-label">
      <span id="budget-label" class="font-mono uppercase text-micro text-text-muted tracking-mono-loose">
        Approximate budget
      </span>
      <div class="flex gap-2 flex-wrap mt-3 mb-3">
        {form.budgets.map((b) => (
          <button
            type="button"
            x-on:click={`form.budget = form.budget === '${b}' ? '' : '${b}'`}
            x-bind:class={`form.budget === '${b}' ? '${pillOn}' : '${pillOff}'`}
            x-bind:aria-pressed={`form.budget === '${b}'`}
            class={pillBase}
          >
            {b}
          </button>
        ))}
      </div>
    </div>

    {/* Message */}
    <label class="block border-t border-hairline pt-5 pb-1 relative">
      <span
        class="font-mono uppercase text-micro transition-colors tracking-mono-loose"
        x-bind:class="focused === 'message' ? 'text-accent' : 'text-text-muted'"
      >
        A few sentences about the project <span class="text-accent">*</span>
      </span>
      <textarea
        required
        rows="5"
        x-model="form.message"
        x-on:focus="focused = 'message'"
        x-on:blur="focused = null"
        placeholder="Tell me where you are, where you'd like to go, and roughly when…"
        class="w-full bg-transparent border-none outline-none font-serif text-lg md:text-title-sm text-text py-2 resize-none leading-[1.4] tracking-tight min-h-30"
      ></textarea>
    </label>

    <div class="border-t border-hairline"></div>

    <p role="alert" x-show="error" x-cloak class="font-mono uppercase text-micro text-accent tracking-mono-loose mt-6">
    Something broke. Email hello@tonyvoorhees.com directly.
    </p>

    <div class="mt-6 md:mt-8 flex justify-between items-start sm:items-center flex-col sm:flex-row gap-4">
      <p class="font-mono uppercase text-micro text-text-muted m-0 sm:max-w-[320px] tracking-mono-loose">
        {form.consent}
      </p>
      <button
        type="submit"
        x-bind:disabled="sending"
        class="bg-accent text-on-accent border border-accent px-5.5 py-3.5 rounded-full font-sans text-sm inline-flex items-center justify-center gap-2.5 cursor-pointer w-full sm:w-auto transition-colors hover:bg-[color-mix(in_oklab,var(--color-accent)_88%,white)] whitespace-nowrap tracking-body disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span x-text={`sending ? 'Sending…' : '${form.submitLabel}'`}></span>
        <svg width="14" height="9" viewBox="0 0 16 10" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M1 5h14M11 1l4 4-4 4" /></svg>
      </button>
    </div>
  </form>

  {/* Thank-you state */}
  <div
    x-ref="thanks"
    tabindex="-1"
    x-show="submitted"
    x-cloak
    class="mt-8 p-8 md:p-14"
    style="border: 1px solid var(--color-accent); background: color-mix(in oklab, var(--color-accent) 5%, var(--color-bg));"
  >
    <p
      class="font-mono uppercase text-label text-accent m-0 tracking-mono-loose"
      x-text={`'${form.thanks.eyebrow}' + (receivedAt ? ' — ' + receivedAt : '')`}
  ></p>

    <h3
      class="font-serif font-350 mt-5 mb-4 tracking-display"
      style="font-size: clamp(1.75rem, 3vw, 2.6rem); line-height: 1.15;"
    >
    Got it, <span x-text="form.name.trim().split(' ')[0]"></span>. I’ll get back to you within <span class="italic">three business days</span>. If it looks like a fit, I’ll suggest a time to talk.    </h3>
    <p class="text-text-muted leading-body text-pretty" set:html={form.thanks.body.replace("hello@tonyvoorhees.com", '<span class="text-text">hello@tonyvoorhees.com</span>')}></p>
  </div>
</div>
